; copy to <game dir>\coop\coop.ini
[net]
; steam: friends-only lobbies and Steam relay-capable P2P, no router setup.
; udp: direct IPv4, for LAN/testing or hosts with port forwarding.
; Older configurations without transport keep using UDP. Changing it needs a restart.
transport=steam
; A joining player may leave this empty and accept an invite or enter an ID in Session.
lobby_id=
; host runs the world (player 1); clients send their hits to it.
; These listen_port / peer_host / peer_port settings are used only with transport=udp.
role=host
listen_port=27900
peer_host=127.0.0.1
peer_port=27900

[sync]
; updates sent per second
send_hz=30
; enemy updates per second (host)
ent_hz=15
; draw the other player this far in the past and blend between updates (0 = latest update)
interp_ms=100
; how far to guess ahead when updates are late
extrap_ms=150
; 0 = do not sync animation
anim=1

[sim]
; fake a bad connection on the receiving side, for testing
latency_ms=0
jitter_ms=0
loss_pct=0
