; copy to <game dir>\coop\coop.ini
[net]
; host runs the world (player 1); clients send their hits to it. A client's peer_host /
; peer_port are the host's address; the host learns the clients' from their packets.
role=host
listen_port=27900
peer_host=127.0.0.1
peer_port=27900

[sync]
; updates sent per second
send_hz=30
; enemy updates per second (host)
ent_hz=15
; draw the other player this far in the past and blend between updates (0 = latest update)
interp_ms=100
; how far to guess ahead when updates are late
extrap_ms=150
; 0 = do not sync animation
anim=1

[sim]
; fake a bad connection on the receiving side, for testing
latency_ms=0
jitter_ms=0
loss_pct=0
